{
  "name": "ciretorres",
  "version": "0.2.16",
  "description": "",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules && rm package-lock.json && npm cache clean -f && npm cache verify",
    "reinstall": "npm run clean && npm i",
    "dev": "vite",
    "build": "vite build && npm run deploy",
    "preview": "vite preview",
    "format": "prettier --write src/",
    "format-lint": "npm run format && npm run lint",
    "lint": "eslint --fix --ignore-pattern .gitignore .",
    "deploy": "cd dist && cp index.html 404.html",
    "test:unit": "vitest"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "pinia": "^2.3.1",
    "sisdai-css": "git+https://codigo.conahcyt.mx/sisdai/sisdai-css#v0.42.9",
    "sisdai-mapas": "git+https://codigo.conahcyt.mx/sisdai/sisdai-mapas#v1.5.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@html-eslint/eslint-plugin": "^0.31.1",
    "@html-eslint/parser": "^0.31.0",
    "@rushstack/eslint-patch": "^1.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.1",
    "sass": "^1.94.2",
    "vite": "^6.4.1",
    "vitest": "^2.1.8",
    "volar-service-vetur": "^0.0.62"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ciretorres/ciretorres.github.io"
  },
  "bugs": {
    "url": "https://github.com/ciretorres/ciretorres.github.io/issues"
